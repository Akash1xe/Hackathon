MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/samvid
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional: converts map pins into readable addresses.
OPENCAGE_API_KEY=

# Required for persistent image uploads in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recommended for production AI evidence analysis. Without it, Samvid safely
# falls back to human review instead of rejecting reports.
HF_TOKEN=
HF_VISION_MODEL=openai/clip-vit-large-patch14-336
